    <task id="Id_fa6295fe-8250-4228-9b2b-679cc0a7ff5b" name="Criar Plano de Tratamento dos Riscos">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;a name="_dx_frag_StartFragment"&gt;&lt;/a&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Segoe UI';font-size:8pt;font-weight:normal;font-style:normal;"&gt;Essa &amp;nbsp;etapa &amp;nbsp;ser&amp;aacute; respons&amp;aacute;vel &amp;nbsp;pela &amp;nbsp;sele&amp;ccedil;&amp;atilde;o &amp;nbsp;e &amp;nbsp;implementa&amp;ccedil;&amp;atilde;o &amp;nbsp;de &amp;nbsp;uma &amp;nbsp;ou mais &amp;nbsp;a&amp;ccedil;&amp;otilde;es &amp;nbsp;de &amp;nbsp;tratamento &amp;nbsp;para modificar os n&amp;iacute;veis de riscos, ou seja, diminuir a probabilidade e impacto do mesmo.&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Segoe UI';font-size:8pt;font-weight:normal;font-style:normal;"&gt;&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Segoe UI';font-size:8pt;font-weight:normal;font-style:normal;"&gt;De acordo com a Pol&amp;iacute;tica de Gest&amp;atilde;o de Riscos, o plano deve conter, pelo menos, as seguintes informa&amp;ccedil;&amp;otilde;es:&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Segoe UI';font-size:8pt;font-weight:normal;font-style:normal;"&gt;&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 36pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Symbol;font-size:8pt;font-weight:normal;font-style:normal;"&gt;&amp;middot; &lt;/span&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Segoe UI';font-size:8pt;font-weight:normal;font-style:normal;"&gt;a justificativa para a sele&amp;ccedil;&amp;atilde;o das op&amp;ccedil;&amp;otilde;es de tratamento, incluindo os benef&amp;iacute;cios esperados a serem obtidos;&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 36pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Symbol;font-size:8pt;font-weight:normal;font-style:normal;"&gt;&amp;middot; &lt;/span&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Segoe UI';font-size:8pt;font-weight:normal;font-style:normal;"&gt;aqueles que s&amp;atilde;o responsabiliz&amp;aacute;veis e respons&amp;aacute;veis por aprovar e implementar o plano;&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 36pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Symbol;font-size:8pt;font-weight:normal;font-style:normal;"&gt;&amp;middot; &lt;/span&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Segoe UI';font-size:8pt;font-weight:normal;font-style:normal;"&gt;as a&amp;ccedil;&amp;otilde;es propostas;&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 36pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Symbol;font-size:8pt;font-weight:normal;font-style:normal;"&gt;&amp;middot; &lt;/span&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Segoe UI';font-size:8pt;font-weight:normal;font-style:normal;"&gt;os recursos requeridos, incluindo conting&amp;ecirc;ncias;&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 36pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Symbol;font-size:8pt;font-weight:normal;font-style:normal;"&gt;&amp;middot; &lt;/span&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Segoe UI';font-size:8pt;font-weight:normal;font-style:normal;"&gt;as medidas de desempenho;&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 36pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Symbol;font-size:8pt;font-weight:normal;font-style:normal;"&gt;&amp;middot; &lt;/span&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Segoe UI';font-size:8pt;font-weight:normal;font-style:normal;"&gt;as restri&amp;ccedil;&amp;otilde;es;&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 36pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Symbol;font-size:8pt;font-weight:normal;font-style:normal;"&gt;&amp;middot; &lt;/span&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Segoe UI';font-size:8pt;font-weight:normal;font-style:normal;"&gt;os relatos e monitoramento requeridos;&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 36pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Symbol;font-size:8pt;font-weight:normal;font-style:normal;"&gt;&amp;middot; &lt;/span&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Segoe UI';font-size:8pt;font-weight:normal;font-style:normal;"&gt;quando se espera que a&amp;ccedil;&amp;otilde;es sejam tomadas e conclu&amp;iacute;das.&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Segoe UI';font-size:8pt;font-weight:normal;font-style:normal;"&gt;&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Segoe UI';font-size:8pt;font-weight:normal;font-style:normal;"&gt;&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Segoe UI';font-size:8pt;font-weight:normal;font-style:normal;"&gt;&amp;nbsp;&lt;/span&gt;&lt;/p&gt;</documentation>
