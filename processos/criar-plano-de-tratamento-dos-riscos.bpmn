      <outgoing>Id_13756e0c-1290-4bc6-9449-9d426f6d288d</outgoing>
    </task>
    <startEvent id="Id_ab19e888-3ab2-435f-8967-cc1485632f39" name="">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Segoe UI';font-size:8pt;font-weight:normal;font-style:normal;"&gt;Este Processo se inciaia quando h&amp;aacute; a necessidade de se criar um novo Plano de Tratamento dos Riscos ou Atualizar um j&amp;aacute; existente.&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Segoe UI';font-size:8pt;font-weight:normal;font-style:normal;"&gt;&amp;nbsp;&lt;/span&gt;&lt;/p&gt;</documentation>
      <outgoing>Id_41e11003-6155-43ab-bada-f5232375079d</outgoing>
    </startEvent>
